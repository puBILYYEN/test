%% 加入沙盒之前的 AI 系統架構（Ubuntu）
%% 實線 = 已確認｜虛線 = 推測或尚未確認
flowchart LR
    user(["👤 你"])

    subgraph host["🖥️ Ubuntu 主機"]
        direction LR
        hermes["🤖 Hermes Agent"]
        ccs["🎚️ CC Switch<br/>（開關）"]
        ide["Antigravity IDE<br/>+ Claude Code"]

        subgraph models["模型"]
            direction TB
            ollama["Ollama<br/>127.0.0.1:11434"]
            poly["PolyStrata<br/>127.0.0.1:8080"]
            ornith[("ORNITH 1.5 35B<br/>主力")]
            gemma[("Gemma 4<br/>圖像辨識")]
            omni["OmniRoute<br/>auto/best-free"]
            other["其他模型"]
        end
    end

    subgraph internet["🌐 網際網路"]
        direction TB
        ollamacom["ollama.com"]
        cloud["免費雲端模型<br/>groq / DuckDuckGo …"]
        anthropic["Anthropic"]
    end

    user -->|"操作"| hermes
    user -->|"操作"| ide
    hermes --> ccs
    ccs --> ollama
    ccs --> poly
    ccs --> omni
    ccs --> other

    ollama -->|"跑"| gemma
    gemma -->|"辨識結果交給"| ornith
    poly -->|"跑"| ornith

    ollama -.->|"Ollama 會自動連"| ollamacom
    omni -->|"best-free 會挑"| cloud
    ide --> anthropic
